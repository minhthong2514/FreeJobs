import cv2
import numpy as np

# Get calibrate params
params = np.load("/home/minhthong/Desktop/code/farmbot/calib-camera/camera_params.npz")
K = params['K']
dist = params['dist']
rvecs = params['rvecs']
tvecs = params['tvecs']

# Display value of K and dist
print(f"\nK: \n{K}")
print(f"\nDistortion: \n{dist}")

# Load image from dataset
img = cv2.imread('/home/minhthong/Desktop/code/farmbot/calib-camera/images/img-23.jpg')
h, w = img.shape[:2]
newK, _ = cv2.getOptimalNewCameraMatrix(K, dist, (w,h), 1)

# Undistort the image
undist_img = cv2.undistort(img, K, dist, None, newK)

# Checkerboard info
CHECKERBOARD = (10, 7)
cols, rows = CHECKERBOARD
squares_size = 5.0               # 5mm

# Create world points
world_pts = np.zeros((cols * rows, 2), dtype=np.float32)
world_pts[:, 0] = np.tile(np.arange(cols), rows) * squares_size
world_pts[:, 1] = np.repeat(np.arange(rows), cols) * squares_size

# Find corners
ret, corners = cv2.findChessboardCorners(undist_img, CHECKERBOARD)
# print(corners.shape)

# Reshape from (N,1,2) to (N,2) 
pixels_pts = corners.reshape(-1, 2)
# print(pixels_pts.shape)

# Find Homography matrix
H, mask = cv2.findHomography(pixels_pts, world_pts, cv2.RANSAC)
print(f"\nHomography matrix: \n{H}")

def pixel_to_world(x, y, H):
    p = np.array([x, y, 1.0])
    P = H @ p
    return P[0] / P[2], P[1] / P[2]

def mouse_callback(event, x, y, flags, param):
    global origin_world, undist_img

    if event == cv2.EVENT_LBUTTONDOWN:

        X, Y = pixel_to_world(x, y, H)

        # CHỌN ORIGIN
        if origin_world is None:
            origin_world = (X, Y)
            print(f"Origin set at: ({X:.2f}, {Y:.2f})mm")

            cv2.circle(undist_img, (x, y), 6, (0, 255, 0), -1)
            cv2.putText(
                undist_img,
                f"ORIGIN(0, 0)mm",
                (x+8, y),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 0),
                2
            )
            return

        # CÁC ĐIỂM KHÁC
        Xr = X - origin_world[0]
        # Yr = Y - origin_world[1]          # Theo toa do cua anh
        Yr = origin_world[1] - Y            # Theo toa do descartes

        cv2.circle(undist_img, (x, y), 4, (0, 0, 255), -1)
        cv2.putText(
            undist_img,
            f"({Xr:.2f},{Yr:.2f}) mm",
            (x+8, y+8),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.5,
            (0, 0, 255),
            1
        )

    if event == cv2.EVENT_LBUTTONDOWN:

        X, Y = pixel_to_world(x, y, H)

        # Nếu origin chưa được chọn → lấy điểm này làm origin
        if origin_world is None:
            origin_world = (X, Y)
            print(f"Origin set at: ({X:.2f}, {Y:.2f})mm")

            cv2.circle(undist_img, (x, y), 6, (0, 255, 0), -1)
            cv2.putText(
                undist_img,
                f"ORIGIN({X:.2f}, {Y:.2f}mm)",
                (x+8, y),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 0),
                2
            )
            return

        print(f"Pixel ({x},{y}) -> World ({Xr:.2f},{Yr:.2f})mm")

        cv2.circle(undist_img, (x, y), 4, (0, 0, 255), -1)
        cv2.putText(
            undist_img,
            f"({Xr:.2f},{Yr:.2f}) mm",
            (x+8, y+8),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.5,
            (0, 0, 255),
            1
        )


cv2.namedWindow("Pixel to World")
cv2.setMouseCallback("Pixel to World", mouse_callback)
origin_world = None
base_img = undist_img.copy()   # ảnh gốc để reset

while True:
    cv2.imshow("Pixel to World", undist_img)
    key = cv2.waitKey(1) & 0xFF

    if key == ord('q'):   # press q to exit
        break

    if key == ord('r'):
        origin_world = None
        undist_img = base_img.copy()   # reset ảnh
        print("Reset Origin + points.")



cv2.destroyAllWindows()

np.savez("/home/minhthong/Desktop/code/farmbot/calib-camera/Homoraphy_value.npz",
         H = H
)
